{
  "name": "@local/dsh-auto-rename",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Retry model-generated session titles from the session menu",
  "peerDependencies": { "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
